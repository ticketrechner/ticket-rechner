---
import Base from '../../layouts/Base.astro';
import routes from '../../data/routes.json';

export function getStaticPaths() {
  return routes.map((route) => ({
    params: { route: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;

const title = `Mit dem Deutschlandticket von ${route.von.city} nach ${route.nach.city} – Verbindung, Fahrzeit & Tipps 2026`;
const description = `${route.von.city} → ${route.nach.city} mit dem Deutschlandticket: ${route.trains[0]} in ${route.reisezeit}. Zwischenhalte, Bahnhof-Ausstattung, Sehenswürdigkeiten & Kosten-Vergleich.`;
const canonical = `https://ticket-rechner.de/strecke/${route.slug}`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Gilt das Deutschlandticket von ${route.von.city} nach ${route.nach.city}?`,
      "acceptedAnswer": { "@type": "Answer", "text": `Ja, das Deutschlandticket gilt für die Nahverkehrsverbindung von ${route.von.city} nach ${route.nach.city}. Du fährst mit ${route.trains[0]}${route.umstiege > 0 ? ' (mit Umstieg)' : ' ohne Umstieg'} in ${route.reisezeit}.` }
    },
    {
      "@type": "Question",
      "name": `Wie lange dauert die Fahrt von ${route.von.city} nach ${route.nach.city}?`,
      "acceptedAnswer": { "@type": "Answer", "text": `Mit dem Regionalverkehr (${route.trains[0]}) dauert die Fahrt ${route.reisezeit}. Im ICE/IC sind es nur ${route.reisezeitICE}.` }
    },
    {
      "@type": "Question",
      "name": `Muss ich umsteigen von ${route.von.city} nach ${route.nach.city}?`,
      "acceptedAnswer": { "@type": "Answer", "text": route.umstiege === 0 ? `Nein, es gibt Direktverbindungen ohne Umstieg.` : `Ja, in der Regel steigst du ${route.umstiege}x um – ${route.umstiegsort}.` }
    },
    {
      "@type": "Question",
      "name": `Kann ich mit dem ICE von ${route.von.city} nach ${route.nach.city} fahren?`,
      "acceptedAnswer": { "@type": "Answer", "text": `Ja, der ICE fährt die Strecke in ${route.reisezeitICE}. Das Deutschlandticket gilt im ICE jedoch nicht – du brauchst ein separates Ticket (Sparpreis ${route.kosten.iceSparpreis}).` }
    },
    {
      "@type": "Question",
      "name": `Was kostet ein Einzelticket von ${route.von.city} nach ${route.nach.city}?`,
      "acceptedAnswer": { "@type": "Answer", "text": `Ein Einzelticket im Nahverkehr kostet ${route.kosten.einzelticket}. Mit dem Deutschlandticket (63 €/Monat) fährst du ohne Zusatzkosten.` }
    },
    {
      "@type": "Question",
      "name": `Gibt es Schließfächer am ${route.nach.station}?`,
      "acceptedAnswer": { "@type": "Answer", "text": route.nach.amenities.schliessfaecher ? `Ja, am ${route.nach.station} gibt es Schließfächer (${route.nach.amenities.schliessfaecherPreis}).` : `Nein, am ${route.nach.station} sind derzeit keine Schließfächer verfügbar.` }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://ticket-rechner.de/" },
    { "@type": "ListItem", "position": 2, "name": "Strecken", "item": "https://ticket-rechner.de/strecke/" },
    { "@type": "ListItem", "position": 3, "name": `${route.von.city} → ${route.nach.city}`, "item": canonical }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": "Redaktion ticket-rechner.de" },
  "publisher": { "@type": "Organization", "name": "ticket-rechner.de", "url": "https://ticket-rechner.de" },
  "datePublished": "2026-08-03",
  "dateModified": "2026-08-03",
  "mainEntityOfPage": canonical
};

const routeSchemas = [faqSchema, breadcrumbSchema, articleSchema];

const reverseSlug = `${route.slug.split('-').reverse().join('-')}`;
const reverseExists = routes.some(r => r.slug === reverseSlug);

function renderAmenityBadge(label: string, available: boolean, detail?: string) {
  if (!available) return '';
  return `<span class="amenity-badge">✓ ${label}${detail ? ` (${detail})` : ''}</span>`;
}
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  schema={routeSchemas}
>
  <main class="route-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Startseite</a> ›
      <span>Strecken</span> ›
      <span>{route.von.city} → {route.nach.city}</span>
    </nav>

    <!-- H1 + Quick Answer -->
    <h1>Mit dem Deutschlandticket von {route.von.city} nach {route.nach.city} – Verbindung, Fahrzeit & Tipps 2026</h1>

    <div class="quick-answer">
      <div class="quick-answer-header">
        <span class="badge badge-green">✓ Deutschlandticket gilt</span>
      </div>
      <p>
        <strong>Ja, du kannst mit dem Deutschlandticket von {route.von.city} nach {route.nach.city} fahren.</strong>
        {route.umstiege === 0
          ? `Der ${route.trains[0]} bringt dich ohne Umstieg in ${route.reisezeit} ans Ziel.`
          : `Du fährst mit ${route.trains[0]} und steigst ${route.umstiege}x um (${route.umstiegsort}). Gesamtfahrzeit: ${route.reisezeit}.`
        }
      </p>
      <div class="quick-facts">
        <div class="quick-fact">
          <span class="quick-fact-label">Fahrzeit</span>
          <span class="quick-fact-value">{route.reisezeit}</span>
        </div>
        <div class="quick-fact">
          <span class="quick-fact-label">Umstiege</span>
          <span class="quick-fact-value">{route.umstiege === 0 ? 'Keine' : `${route.umstiege}x`}</span>
        </div>
        <div class="quick-fact">
          <span class="quick-fact-label">Entfernung</span>
          <span class="quick-fact-value">{route.entfernungKm} km</span>
        </div>
        <div class="quick-fact">
          <span class="quick-fact-label">Züge</span>
          <span class="quick-fact-value">{route.trains.join(', ')}</span>
        </div>
        <div class="quick-fact">
          <span class="quick-fact-label">Taktung</span>
          <span class="quick-fact-value">{route.taktung}</span>
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <nav class="toc">
      <h2>Inhalt</h2>
      <ol>
        <li><a href="#verbindung">Verbindung im Überblick</a></li>
        <li><a href="#zwischenhalte">Alle Zwischenhalte</a></li>
        <li><a href="#bahnhof-start">Bahnhof {route.von.city}</a></li>
        <li><a href="#bahnhof-ziel">Bahnhof {route.nach.city}</a></li>
        <li><a href="#sehenswuerdigkeiten-ziel">Sehenswürdigkeiten in {route.nach.city}</a></li>
        <li><a href="#sehenswuerdigkeiten-start">Sehenswürdigkeiten in {route.von.city}</a></li>
        <li><a href="#kosten">Kosten-Vergleich</a></li>
        <li><a href="#tipps">Reisetipps für diese Strecke</a></li>
        <li><a href="#rueckfahrt">Rückfahrt</a></li>
        <li><a href="#aehnliche-strecken">Ähnliche Strecken</a></li>
        <li><a href="#faq">Häufige Fragen (FAQ)</a></li>
      </ol>
    </nav>

    <!-- Route Overview -->
    <section id="verbindung">
      <h2>Verbindung von {route.von.city} nach {route.nach.city} im Überblick</h2>
      <p>
        Auf der Strecke {route.von.city}–{route.nach.city} fahren die Nahverkehrszüge <strong>{route.trains.join(', ')}</strong>.
        {route.umstiege === 0
          ? `Du erreichst dein Ziel ohne Umstieg in ${route.reisezeit}.`
          : `Mit Umstieg in ${route.umstiegsort} bist du in ${route.reisezeit} am Ziel.`
        }
      </p>

      <div class="comparison-box">
        <div class="comparison-item">
          <span class="comparison-label">Nahverkehr (D-Ticket)</span>
          <span class="comparison-value">{route.reisezeit}</span>
          <span class="comparison-badge badge-green">✓ Gilt</span>
        </div>
        <div class="comparison-item">
          <span class="comparison-label">ICE / IC</span>
          <span class="comparison-value">{route.reisezeitICE}</span>
          <span class="comparison-badge badge-red">✗ Gilt nicht</span>
        </div>
      </div>
      <p style="font-size:0.9rem;margin:0.5rem 0 1.2rem;color:var(--ink-soft);">
        💡 <em>Vergleich & Ausnahmen: <a href="/ratgeber/deutschlandticket-ice">Gilt das Deutschlandticket im ICE?</a></em>
        {route.slug.includes('basel') || route.slug.includes('flensburg') ? (
          <span> · 🌍 <em><a href="/ratgeber/deutschlandticket-ausland">Gültigkeit im Ausland & Grenznähe</a></em></span>
        ) : null}
      </p>

      <div class="info-grid">
        <div class="info-item">
          <strong>Erste Fahrt:</strong> {route.ersteFahrt}
        </div>
        <div class="info-item">
          <strong>Letzte Fahrt:</strong> {route.letzteFahrt}
        </div>
        <div class="info-item">
          <strong>Taktung:</strong> {route.taktung}
        </div>
        <div class="info-item">
          <strong>Entfernung:</strong> {route.entfernungKm} km
        </div>
      </div>

      <p class="cta-link">
        👉 <a href={`https://www.bahn.de/buchung/fahrplan/suche#sts=true&so=${encodeURIComponent(route.von.station)}&zo=${encodeURIComponent(route.nach.station)}&kl=2&r=13:16:KLASSENLOS:1&soid=&zoid=`} target="_blank" rel="noopener noreferrer">Aktuelle Verbindungen auf bahn.de anzeigen</a>
      </p>
    </section>

    <!-- Zwischenhalte Timeline -->
    <section id="zwischenhalte">
      <h2>Alle Zwischenhalte: {route.von.city} → {route.nach.city}</h2>
      <div class="timeline">
        <div class="timeline-stop timeline-stop-start">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <strong>{route.von.station}</strong>
            <span class="timeline-time">Abfahrt</span>
          </div>
        </div>
        {route.zwischenhalte.map((halt) => (
          <div class="timeline-stop">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <strong>{halt.name}</strong>
              <span class="timeline-time">+ {halt.fahrzeit}</span>
            </div>
          </div>
        ))}
        <div class="timeline-stop timeline-stop-end">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <strong>{route.nach.station}</strong>
            <span class="timeline-time">Ankunft nach {route.reisezeit}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Origin Station Amenities -->
    <section id="bahnhof-start">
      <h2>Abfahrtsbahnhof: {route.von.station}</h2>
      <div class="station-card">
        <div class="station-meta">
          
          {route.von.amenities.barrierefrei && <span class="badge badge-blue">♿ Barrierefrei</span>}
          {route.von.amenities.dbLounge && <span class="badge">DB Lounge</span>}
        </div>

        <h3>Ausstattung & Service</h3>
        <div class="amenities-grid">
          {route.von.amenities.schliessfaecher && (
            <div class="amenity-item">
              <span class="amenity-icon">🔐</span>
              <div>
                <strong>Schließfächer</strong>
                <p>{route.von.amenities.schliessfaecherPreis}</p>
              </div>
            </div>
          )}
          {route.von.amenities.wc && (
            <div class="amenity-item">
              <span class="amenity-icon">🚻</span>
              <div>
                <strong>WC / Toiletten</strong>
                <p>{route.von.amenities.wcPreis}</p>
              </div>
            </div>
          )}
          {route.von.amenities.wlan && (
            <div class="amenity-item">
              <span class="amenity-icon">📶</span>
              <div>
                <strong>WLAN</strong>
                <p>{route.von.amenities.wlanKosten}</p>
              </div>
            </div>
          )}
          {route.von.amenities.aufzuege && (
            <div class="amenity-item">
              <span class="amenity-icon">🛗</span>
              <div>
                <strong>Aufzüge</strong>
                <p>Verfügbar</p>
              </div>
            </div>
          )}
          {route.von.amenities.reisezentrum && (
            <div class="amenity-item">
              <span class="amenity-icon">🎫</span>
              <div>
                <strong>Reisezentrum</strong>
                <p>{route.von.amenities.reisezentrumZeiten}</p>
              </div>
            </div>
          )}
          {route.von.amenities.parkAndRide && (
            <div class="amenity-item">
              <span class="amenity-icon">🅿️</span>
              <div>
                <strong>Park & Ride</strong>
                <p>{route.von.amenities.parkAndRideKapazitaet}</p>
              </div>
            </div>
          )}
        </div>
        <p class="station-gastro"><strong>Gastronomie:</strong> {route.von.amenities.gastronomie}</p>
      </div>
    </section>

    <!-- Destination Station Amenities -->
    <section id="bahnhof-ziel">
      <h2>Zielbahnhof: {route.nach.station}</h2>
      <div class="station-card">
        <div class="station-meta">
          
          {route.nach.amenities.barrierefrei && <span class="badge badge-blue">♿ Barrierefrei</span>}
          {route.nach.amenities.dbLounge && <span class="badge">DB Lounge</span>}
        </div>

        <h3>Ausstattung & Service</h3>
        <div class="amenities-grid">
          {route.nach.amenities.schliessfaecher && (
            <div class="amenity-item">
              <span class="amenity-icon">🔐</span>
              <div>
                <strong>Schließfächer</strong>
                <p>{route.nach.amenities.schliessfaecherPreis}</p>
              </div>
            </div>
          )}
          {route.nach.amenities.wc && (
            <div class="amenity-item">
              <span class="amenity-icon">🚻</span>
              <div>
                <strong>WC / Toiletten</strong>
                <p>{route.nach.amenities.wcPreis}</p>
              </div>
            </div>
          )}
          {route.nach.amenities.wlan && (
            <div class="amenity-item">
              <span class="amenity-icon">📶</span>
              <div>
                <strong>WLAN</strong>
                <p>{route.nach.amenities.wlanKosten}</p>
              </div>
            </div>
          )}
          {route.nach.amenities.aufzuege && (
            <div class="amenity-item">
              <span class="amenity-icon">🛗</span>
              <div>
                <strong>Aufzüge</strong>
                <p>Verfügbar</p>
              </div>
            </div>
          )}
          {route.nach.amenities.reisezentrum && (
            <div class="amenity-item">
              <span class="amenity-icon">🎫</span>
              <div>
                <strong>Reisezentrum</strong>
                <p>{route.nach.amenities.reisezentrumZeiten}</p>
              </div>
            </div>
          )}
          {route.nach.amenities.parkAndRide && (
            <div class="amenity-item">
              <span class="amenity-icon">🅿️</span>
              <div>
                <strong>Park & Ride</strong>
                <p>{route.nach.amenities.parkAndRideKapazitaet}</p>
              </div>
            </div>
          )}
        </div>
        <p class="station-gastro"><strong>Gastronomie:</strong> {route.nach.amenities.gastronomie}</p>
      </div>
    </section>

    <!-- Destination Attractions -->
    <section id="sehenswuerdigkeiten-ziel">
      <h2>Sehenswürdigkeiten in {route.nach.city}</h2>
      <div class="attractions-list">
        {route.nach.attractions.map((attr, i) => (
          <div class="attraction-card">
            <div class="attraction-header">
              <h3>{attr.name}</h3>
              <span class="attraction-type">{attr.typ}</span>
            </div>
            <p>{attr.beschreibung}</p>
            <div class="attraction-details">
              <span>📍 {attr.entfernungKm < 1 ? `${(attr.entfernungKm * 1000).toFixed(0)} m` : `${attr.entfernungKm} km`} vom Hbf{attr.gehzeit !== '–' ? ` (${attr.gehzeit} zu Fuß)` : ''}</span>
              <span>🚉 {attr.anfahrt}</span>
              <span>💶 {attr.eintritt}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Origin Attractions -->
    <section id="sehenswuerdigkeiten-start">
      <h2>Sehenswürdigkeiten in {route.von.city}</h2>
      <div class="attractions-list">
        {route.von.attractions.map((attr) => (
          <div class="attraction-card">
            <div class="attraction-header">
              <h3>{attr.name}</h3>
              <span class="attraction-type">{attr.typ}</span>
            </div>
            <p>{attr.beschreibung}</p>
            <div class="attraction-details">
              <span>📍 {attr.entfernungKm < 1 ? `${(attr.entfernungKm * 1000).toFixed(0)} m` : `${attr.entfernungKm} km`} vom Hbf{attr.gehzeit !== '–' ? ` (${attr.gehzeit} zu Fuß)` : ''}</span>
              <span>🚉 {attr.anfahrt}</span>
              <span>💶 {attr.eintritt}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Cost Comparison -->
    <section id="kosten">
      <h2>Kosten-Vergleich: {route.von.city} → {route.nach.city}</h2>
      <div class="cost-table-wrapper">
        <table class="cost-table">
          <thead>
            <tr>
              <th>Verkehrsmittel</th>
              <th>Preis</th>
              <th>Fahrzeit</th>
              <th>D-Ticket?</th>
            </tr>
          </thead>
          <tbody>
            <tr class="highlight-row">
              <td><strong>Deutschlandticket (RE/RB)</strong></td>
              <td><strong>0 € (im 63 €/Mon. Abo)</strong></td>
              <td>{route.reisezeit}</td>
              <td><span class="badge badge-green">✓ Gilt</span></td>
            </tr>
            <tr>
              <td>Einzelticket Nahverkehr</td>
              <td>{route.kosten.einzelticket}</td>
              <td>{route.reisezeit}</td>
              <td>Nicht nötig</td>
            </tr>
            <tr>
              <td>ICE Sparpreis</td>
              <td>{route.kosten.iceSparpreis}</td>
              <td>{route.reisezeitICE}</td>
              <td><span class="badge badge-red">✗ Gilt nicht</span></td>
            </tr>
            <tr>
              <td>ICE Flexpreis</td>
              <td>{route.kosten.iceFlexpreis}</td>
              <td>{route.reisezeitICE}</td>
              <td><span class="badge badge-red">✗ Gilt nicht</span></td>
            </tr>
            <tr>
              <td>Auto (Sprit + Verschleiß)</td>
              <td>{route.kosten.auto}</td>
              <td>variiert</td>
              <td>—</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="cost-verdict">
        <strong>Fazit:</strong> Mit dem Deutschlandticket sparst du dir {route.kosten.einzelticket} pro Fahrt gegenüber dem Einzelticket.
        Bei regelmäßigen Fahrten amortisiert sich das 63-€-Abo schnell.
        <a href="/lohnt-sich-rechner">Rechnet sich das D-Ticket für dich? → Lohnt-sich-Rechner</a>
      </p>
    </section>

    <!-- Travel Tips -->
    <section id="tipps">
      <h2>Praktische Reisetipps: {route.von.city} → {route.nach.city}</h2>
      <div class="tips-list">
        {route.tipps.map((tipp) => (
          <div class="tip-card">
            <h3>{tipp.title}</h3>
            <p>{tipp.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Return Journey -->
    <section id="rueckfahrt">
      <h2>Rückfahrt: {route.nach.city} → {route.von.city}</h2>
      {reverseExists ? (
        <p>
          Die Rückfahrt von {route.nach.city} nach {route.von.city} funktioniert genauso – die Züge fahren auf der gleichen Strecke.
          <a href={`/strecke/${reverseSlug}`}>→ Zur Strecke {route.nach.city} → {route.von.city}</a>
        </p>
      ) : (
        <p>
          Die Rückfahrt von {route.nach.city} nach {route.von.city} funktioniert genauso – die Züge fahren auf der gleichen Strecke mit den gleichen Halten.
          {route.umstiege > 0
            ? ` Achte auf den Umstieg – die Umstiegszeiten können auf der Rückfahrt etwas anders sein.`
            : ''
          }
          Prüfe die aktuellen Verbindungen auf <a href="https://www.bahn.de" target="_blank" rel="noopener noreferrer">bahn.de</a>.
        </p>
      )}
    </section>

    <!-- Related Routes -->
    <section id="aehnliche-strecken">
      <h2>Ähnliche Strecken</h2>
      <div class="related-routes">
        {route.related.map((relSlug) => {
          const rel = routes.find(r => r.slug === relSlug);
          if (!rel) return null;
          return (
            <a href={`/strecke/${rel.slug}`} class="related-route-card">
              <strong>{rel.von.city} → {rel.nach.city}</strong>
              <span>{rel.trains[0]} · {rel.reisezeit}</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <h2>Häufige Fragen: {route.von.city} → {route.nach.city}</h2>
      <div class="faq-list">
        <details>
          <summary>Gilt das Deutschlandticket von {route.von.city} nach {route.nach.city}?</summary>
          <p>Ja, das Deutschlandticket gilt für alle Nahverkehrszüge ({route.trains.join(', ')}) auf dieser Strecke. Du zahlst keine zusätzlichen Kosten über die 63 € monatlich hinaus.</p>
        </details>
        <details>
          <summary>Wie lange dauert die Fahrt von {route.von.city} nach {route.nach.city}?</summary>
          <p>Mit dem Regionalverkehr ({route.trains[0]}) dauert die Fahrt {route.reisezeit}. Der ICE ist mit {route.reisezeitICE} deutlich schneller, das Deutschlandticket gilt dort aber nicht.</p>
        </details>
        <details>
          <summary>Muss ich umsteigen?</summary>
          <p>{route.umstiege === 0 ? `Nein, es gibt Direktverbindungen ohne Umstieg von ${route.von.station} nach ${route.nach.station}.` : `Ja, in der Regel steigst du ${route.umstiege}x um: ${route.umstiegsort}.`}</p>
        </details>
        <details>
          <summary>Kann ich mit dem ICE von {route.von.city} nach {route.nach.city} fahren?</summary>
