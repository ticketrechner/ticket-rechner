---
import Base from '../../layouts/Base.astro';
const articles = [
  { slug: 'deutschlandticket-kaufen', title: 'Deutschlandticket kaufen: Wo, wie & worauf du achten musst', teaser: 'DB, deutschlandticket.de oder dein Verbund? Handyticket oder Chipkarte? Alle Kaufwege, Zahlungsmethoden und die 5 häufigsten Fehler.' },
  { slug: 'deutschlandticket-steuer-absetzen', title: 'Deutschlandticket von der Steuer absetzen 2026', teaser: 'Pendlerpauschale oder Ticketkosten? Ab 10 km Arbeitsweg lohnt sich die Pauschale mehr. So trägst du es richtig ein.' },
  { slug: 'deutschlandticket-ausland', title: 'Deutschlandticket im Ausland: Wo gilt es über die Grenze?', teaser: 'Grundsätzlich nein — aber es gibt Grenztarifpunkte und Sonderregelungen für Österreich, Frankreich, Niederlande und mehr.' },
  { slug: 'deutschlandticket-kinder', title: 'Deutschlandticket für Kinder & Familien 2026', teaser: 'Unter 6 kostenlos, darüber variieren die Regeln nach Bundesland. Berlin und Hamburg gratis, Bayern 29 €.' },
  { slug: 'deutschlandticket-schueler', title: 'Deutschlandticket für Schüler 2026: Preise nach Bundesland', teaser: 'Von kostenlos (Hamburg) bis 45 € (BW) — alle Ermäßigungen, Bestellwege und was Eltern wissen müssen.' },
  { slug: 'deutschlandticket-verloren', title: 'Deutschlandticket verloren oder Handy kaputt: Was tun?', teaser: 'Handyticket: neues Gerät, App neu einrichten. Chipkarte: sperren, Ersatz beantragen.' },
  { slug: 'deutschlandticket-gestohlen', title: 'Deutschlandticket gestohlen: Sofort-Anleitung bei Diebstahl', teaser: 'Polizeianzeige, Sperrung, Ersatz — die komplette Notfall-Checkliste für Chipkarte und Handy.' },
  { slug: 'deutschlandticket-ersatzkarte', title: 'Deutschlandticket Ersatzkarte: Kosten, Anbieter & Anleitung', teaser: 'Alle Anbieter, Gebühren (10–25 €), Lieferzeiten und wann der Wechsel aufs Handyticket besser ist.' },
  { slug: 'deutschlandticket-gesperrt', title: 'Deutschlandticket gesperrt: Gründe & Soforthilfe', teaser: 'Die 7 häufigsten Sperrgründe — von Lastschrift-Problemen bis Betrugsverdacht — und wie du es freischaltest.' },
  { slug: 'deutschlandticket-app-funktioniert-nicht', title: 'Deutschlandticket App funktioniert nicht: Alle Lösungen', teaser: 'Ticket nicht angezeigt, QR-Code fehlt, Login klappt nicht? Finde dein Problem und löse es in 2 Minuten.' },
  { slug: 'deutschlandticket-erstattung', title: 'Deutschlandticket Erstattung: Wann gibt es Geld zurück?', teaser: 'Verspätung (1,50 € pro Fall), Krankheit, Doppelzahlung — wann du Anspruch hast und wann nicht.' },
  { slug: 'deutschlandticket-verlaengern', title: 'Deutschlandticket verlängern: Musst du etwas tun?', teaser: 'Automatische Verlängerung, Reaktivierung nach Kündigung und was bei Preiserhöhungen passiert.' },
  { slug: 'deutschlandticket-kundenservice', title: 'Deutschlandticket Kundenservice: Alle Kontakte & Hotlines', teaser: 'Telefonnummern, E-Mail, Kundenportale — die richtige Anlaufstelle für jedes Problem.' },
  { slug: 'deutschlandticket-vs-bahncard', title: 'Deutschlandticket vs. BahnCard: Was lohnt sich für wen?', teaser: 'Nahverkehr-Flatrate oder Fernverkehr-Rabatt? Der direkte Vergleich mit Preistabelle und Entscheidungshilfe.' },
  { slug: 'deutschlandticket-jobticket', title: 'Deutschlandticket als Jobticket: nur 44,10 € statt 63 €', teaser: 'Arbeitgeber zahlt 25 %, dazu 5 % Rabatt — steuerfrei nach § 3 Nr. 15 EStG. So fragst du richtig nach.' },
  { slug: 'deutschlandticket-studenten', title: 'Deutschlandticket für Studenten: Das Semesterticket 2026', teaser: '34,80 € im Sommersemester, 37,80 € ab WS 2026/27 — bundesweit gültig. Solidarmodell vs. Upgrade erklärt.' },
  { slug: 'deutschlandticket-kosten', title: 'Was kostet das Deutschlandticket 2026? Alle Preise & Varianten', teaser: '63 € regulär, 44,10 € Jobticket, 37,80 € Semesterticket — plus Sozialticket und Preisentwicklung.' },
  { slug: 'deutschlandticket-preiserhoehung', title: 'Deutschlandticket Preiserhöhung: von 58 auf 63 €', teaser: 'Warum der Preis stieg, wie es 2027 weitergeht, und ob sich das Ticket bei deinem Fahrverhalten noch rechnet.' },
  { slug: 'deutschlandticket-mitnahme', title: 'Deutschlandticket Mitnahme: Fahrrad, Hund, Personen', teaser: 'Fahrrad braucht Extra-Ticket, Hunde-Regeln sind regional, Personen mitnehmen geht nicht — alle Details.' },
  { slug: 'deutschlandticket-erste-klasse', title: 'Deutschlandticket 1. Klasse: geht das?', teaser: 'Nein — nur 2. Klasse. Regionale Upgrades, was bei der Kontrolle passiert und welche Alternativen es gibt.' },
  { slug: 'deutschlandticket-pausieren', title: 'Deutschlandticket pausieren: geht das?', teaser: 'Offizielle Pause? Nein. Aber Kündigen und Wiederkommen spart 63 € pro Monat — Schritt für Schritt erklärt.' },
  { slug: 'deutschlandticket-ice', title: 'Gilt das Deutschlandticket im ICE? Regeln & Ausnahmen 2026', teaser: 'Grundsätzlich nein — aber es gibt offizielle Ausnahmestrecken und die Zugausfall-Regel.' },
  { slug: 'deutschlandticket-gueltigkeit', title: 'Wo gilt das Deutschlandticket? Der komplette Überblick', teaser: 'Welche Züge, Busse und Fähren enthalten sind, was nicht gilt — plus Fahrrad- und Hunde-Regeln.' },
  { slug: 'deutschlandticket-kuendigen', title: 'Deutschlandticket kündigen 2026: Frist, Anleitung & Vorlage', teaser: 'Bis zum 10. des Monats kündigen — sonst kostet es 63 € extra. Alle Wege, Fristen und die Pause-Strategie.' },
  { slug: 'deutschlandticket-senioren', title: 'Deutschlandticket für Senioren & Rentner 2026: Alle Rabatte im Überblick', teaser: '29 € in MV, 39 € in Hessen — alle regionalen Senioren-Rabatte, Voraussetzungen und Vergleich zur BahnCard.' },
  { slug: 'deutschlandticket-sozialticket', title: 'Deutschlandticket Sozialticket 2026: Preise, Anspruch & Antrag', teaser: 'Bürgergeld, Wohngeld und Grundsicherung: Preise ab 19 €, Nachweise und Schritt-für-Schritt-Beantragung.' },
  { slug: 'deutschlandticket-uebertragbar', title: 'Ist das Deutschlandticket übertragbar? Alle Regeln zur Weitergabe', teaser: 'Strikt personengebunden — was bei Weitergabe droht (60 € EBE, Einzug) und welche Alternativen Familien haben.' },
  { slug: 'deutschlandticket-kontrolle', title: 'Deutschlandticket Kontrolle 2026: Was passiert ohne Ticket?', teaser: 'Ticket vergessen oder Akku leer? So senkst du die 60 € Strafe auf 7 € Bearbeitungsgebühr (14-Tage-Frist).' },
  { slug: 'deutschlandticket-anbieter-wechseln', title: 'Deutschlandticket Anbieter wechseln 2026: So geht\'s ohne Lücke', teaser: 'Vom DB-Abo zu mo.pla, HVV oder BVG: Schritt-für-Schritt-Wechsel ohne Doppelzahlung und ohne Lücke.' },
  { slug: 'deutschlandticket-zukunft-2027', title: 'Deutschlandticket Zukunft 2027: Wird es teurer oder abgeschafft?', teaser: 'Finanzierung bis 2030 gesichert — wie der neue automatische Preisindex ab 2027 funktioniert.' },
  { slug: 'deutschlandticket-lastschrift', title: 'Deutschlandticket Lastschrift & Zahlungsprobleme: Alle Lösungen', teaser: 'Fehlgeschlagene Lastschriften, doppelte Abbuchungen und IBAN-Wechsel — so vermeidest du Ticket-Sperrungen.' },
  { slug: 'deutschlandticket-faehre-nachtzug', title: 'Deutschlandticket auf Fähren, im Nachtzug & Sonderverkehr 2026', teaser: 'Hafenfähren, Nacht-S-Bahnen, FlixTrain, Seilbahnen und Schmalspurbahnen: Was gilt und was nicht.' }
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://ticket-rechner.de" },
      { "@type": "ListItem", "position": 2, "name": "Ratgeber", "item": "https://ticket-rechner.de/ratgeber" }
    ]
  }
];
---
<Base
  title="Deutschlandticket Ratgeber 2026 | ticket-rechner.de"
  description="Alle Ratgeber rund ums Deutschlandticket: kaufen, kündigen, Erstattung, App-Probleme, Kundenservice, Steuer und mehr — aktuell für 2026."
  schema={schema}
>
  <div class="container--narrow" style="padding:2rem 0 1rem">
    <h1>Ratgeber</h1>
    <p style="color:var(--ink-soft)">
      Antworten auf die häufigsten Fragen rund ums Deutschlandticket — kompakt,
      aktuell und ohne Fachchinesisch. Diese Sammlung wächst laufend.
    </p>
    {articles.map(a => (
      <a class="card" href={`/ratgeber/${a.slug}`} style="display:block;text-decoration:none;color:inherit;margin-top:1rem">
        <h2 style="margin:0 0 .3rem;font-size:1.15rem">{a.title}</h2>
        <p style="margin:0;color:var(--ink-soft);font-size:.95rem">{a.teaser}</p>
      </a>
    ))}
  </div>
</Base>
