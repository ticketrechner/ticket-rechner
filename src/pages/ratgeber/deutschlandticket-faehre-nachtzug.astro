            <td style="padding:.5rem .75rem">Ja ✅</td>
            <td style="padding:.5rem .75rem">Inklusive Linie 62 nach Finkenwerder</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem"><strong>BVG-Fähren Berlin (F10 - F24)</strong></td>
