            <th style="padding:.5rem .75rem">Region / Verbund</th>
            <th style="padding:.5rem .75rem">Gültig?</th>
            <th style="padding:.5rem .75rem">Hinweis</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid var(--line)">
