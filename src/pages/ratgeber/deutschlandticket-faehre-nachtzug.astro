            <td style="padding:.5rem .75rem">Ja ✅</td>
            <td style="padding:.5rem .75rem">Inklusive Wannsee-Fähre (F10)</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem"><strong>Kieler Fördefähren (SFK)</strong></td>
            <td style="padding:.5rem .75rem">Kiel (VRK)</td>
            <td style="padding:.5rem .75rem">Ja ✅</td>
            <td style="padding:.5rem .75rem">Gilt auf allen Linien der SFK</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
