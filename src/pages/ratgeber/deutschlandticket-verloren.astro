            <td style="padding:.5rem .75rem">3–5 Werktage</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem">MVV / MVG (München)</td>
            <td style="padding:.5rem .75rem">089 41 42 43 44</td>
            <td style="padding:.5rem .75rem">10 €</td>
            <td style="padding:.5rem .75rem">2–4 Werktage</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem">BVG (Berlin)</td>
            <td style="padding:.5rem .75rem">030 19 449</td>
            <td style="padding:.5rem .75rem">10 €</td>
            <td style="padding:.5rem .75rem">2–5 Werktage</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem">VRR (Ruhrgebiet)</td>
            <td style="padding:.5rem .75rem">0800 504 030 4</td>
            <td style="padding:.5rem .75rem">15 €</td>
            <td style="padding:.5rem .75rem">3–5 Werktage</td>
          </tr>
          <tr>
            <td style="padding:.5rem .75rem">VRS (Köln/Bonn)</td>
            <td style="padding:.5rem .75rem">0180 350 40 30</td>
