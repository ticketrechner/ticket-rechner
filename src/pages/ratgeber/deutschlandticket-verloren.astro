            <th style="padding:.5rem .75rem">Ersatzkarte</th>
            <th style="padding:.5rem .75rem">Bearbeitungszeit</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem">DB (Abo online)</td>
