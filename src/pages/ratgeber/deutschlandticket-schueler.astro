          <td>Schulträger / Schulsekretariat</td>
        </tr>
        <tr>
          <td>NRW (Selbstzahler)</td>
          <td>DT Schule</td>
          <td>43 €</td>
          <td>Vollzeitschüler (Schule muss Vertrag haben)</td>
