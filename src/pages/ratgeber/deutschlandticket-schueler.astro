          <td>Schleswig-Holstein</td>
          <td>Deutschland-Schulticket</td>
          <td>43 € (mind. 20 € Rabatt)</td>
          <td>Schüler + Azubis in schulischer Ausbildung</td>
          <td>OLAV-Verfahren oder Verkehrspartner</td>
        </tr>
        <tr>
          <td>Baden-Württemberg</td>
          <td>D-Ticket JugendBW</td>
          <td>45 €</td>
          <td>Unter 21 (alle) oder unter 27 (mit Ausbildungsnachweis)</td>
          <td>Verbund-App oder Aboportal</td>
        </tr>
        <tr>
          <td>Bayern (Azubis/Studis)</td>
          <td>Bayerisches Ermäßigungsticket</td>
          <td>43 €</td>
          <td>Azubis, Studierende, FSJ — <strong>nicht</strong> Schüler</td>
          <td>Verbund oder Aboportal DB Regio</td>
        </tr>
        <tr>
          <td>Bayern (Schüler)</td>
          <td>Schulwegkostenfreiheit / 365-€-Ticket</td>
          <td>0 € (Schulweg) / 365 €/Jahr</td>
