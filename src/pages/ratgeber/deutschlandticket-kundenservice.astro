          <td>HVV (Hamburg)</td>
          <td>040 / 19 449</td>
          <td>meinhvv-Kundenkonto</td>
          <td>Mo–Fr + auch außerhalb der Geschäftszeiten</td>
        </tr>
        <tr>
          <td>MVG (München)</td>
          <td>Kontakt-Assistent auf mvg.de</td>
          <td>Kundenportal unter Vertragsverwaltung</td>
          <td>Online rund um die Uhr</td>
        </tr>
