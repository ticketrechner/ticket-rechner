          <td>Ja</td>
          <td>Ja</td>
          <td>Nein</td>
          <td>Nein</td>
          <td>Nein</td>
        </tr>
        <tr>
          <td>mo.pla</td>
          <td>Ja</td>
          <td>Ja</td>
