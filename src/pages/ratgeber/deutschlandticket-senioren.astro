            <td style="padding:.5rem .75rem">Ab ca. 38,90 € pro Jahr (BC 25)</td>
          </tr>
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:.5rem .75rem"><strong>Gültigkeit ICE / IC</strong></td>
