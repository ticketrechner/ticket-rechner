        <tr>
          <td>Was ist es?</td>
          <td>Ein Ticket (Fahrschein)</td>
          <td>Eine Rabattkarte (kein Ticket)</td>
          <td>Flatrate-Ticket (Fern + Nah)</td>
        </tr>
        <tr>
          <td>Preis 2026</td>
          <td>63 €/Monat (756 €/Jahr)</td>
          <td>BC25: 62,90 €/Jahr · BC50: 244 €/Jahr</td>
          <td>4.899 €/Jahr (2. Klasse)</td>
        </tr>
        <tr>
          <td>Gültig in</td>
          <td>Nahverkehr (RE, RB, S-Bahn, Bus, U-Bahn, Tram)</td>
