        </tr>
        <tr>
          <td>Sofort-Ersatz im Kundenzentrum</td>
          <td>10–25 €</td>
          <td>Sofort</td>
          <td>Dringender Bedarf, Kundenzentrum erreichbar</td>
        </tr>
        <tr>
