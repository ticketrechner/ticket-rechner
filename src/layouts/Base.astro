---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}
const pathname = Astro.url.pathname.endsWith('/') && Astro.url.pathname !== '/' ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:image" content="https://ticket-rechner.de/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://ticket-rechner.de/og-image.png" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="google-site-verification" content="8E0by14vur5uZ_JZRApTR-F0kV8BwVurdqWkhRlau2o" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a class="logo" href="/">ticket-rechner<span class="tld">.de</span><span class="logo-badge">D-Ticket</span></a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label="Navigation öffnen"
      >
        <span class="menu-icon">☰</span>
      </button>
      <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
        <a href="/#streckensuche">Strecken</a>
        <a href="/kuendigungsfrist-rechner">Kündigungsfrist</a>
        <a href="/lohnt-sich-rechner">Lohnt es sich?</a>
        <a href="/kuendigungsschreiben">Kündigungsschreiben</a>
        <a href="/ratgeber">Ratgeber</a>
      </nav>
    </div>
  </header>

  <script is:inline>
    (function() {
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('main-nav');
      if (!toggle || !nav) return;

      function setMenuState(open) {
        const isOpen = open !== undefined ? open : toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Navigation schließen' : 'Navigation öffnen');
        const icon = toggle.querySelector('.menu-icon');
        if (icon) icon.textContent = isOpen ? '✕' : '☰';
        nav.classList.toggle('is-open', isOpen);
      }

      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        setMenuState();
      });

      nav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', function() {
          setMenuState(false);
        });
      });

      document.addEventListener('click', function(e) {
        if (!nav.contains(e.target) && !toggle.contains(e.target)) {
          setMenuState(false);
        }
      });
    })();
  </script>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <span>© {new Date().getFullYear()} ticket-rechner.de — Unabhängiges Informationsportal. Keine offizielle Seite der Deutschen Bahn oder eines Verkehrsverbunds.</span>
      <span>
        <a href="/ueber-uns">Über uns</a> ·
        <a href="/kontakt">Kontakt</a> ·
        <a href="/impressum">Impressum</a> ·
        <a href="/datenschutz">Datenschutz</a>
      </span>
    </div>
  </footer>
  <CookieConsent />
</body>
</html>

