---
import routes from '../data/routes.json';

// Build list of unique cities with their station info
const cityMap = new Map<string, { city: string; station: string }>();
routes.forEach(r => {
  if (r.von?.city) cityMap.set(r.von.city, { city: r.von.city, station: r.von.station });
  if (r.nach?.city) cityMap.set(r.nach.city, { city: r.nach.city, station: r.nach.station });
});

const cities = Array.from(cityMap.values()).sort((a, b) => a.city.localeCompare(b.city, 'de'));

// Popular quick routes
const popularRoutes = routes.slice(0, 6).map(r => ({
  slug: r.slug,
  from: r.von.city,
  to: r.nach.city,
  train: r.trains[0],
  time: r.reisezeit
}));
---

<div class="route-finder card">
  <div class="route-finder-header">
    <span class="route-finder-badge">⚡ D-Ticket Streckenfinder</span>
    <h2>Finde deine Verbindung im Nahverkehr</h2>
    <p>Wähle Start- und Zielort, um Fahrzeit, Direktverbindungen und Bahnhofs-Infos zu sehen.</p>
  </div>

  <form id="route-finder-form" class="route-finder-form" onsubmit="return false;">
    <div class="input-group">
      <label for="route-von">Abfahrtsort (Von)</label>
      <div class="autocomplete-wrapper">
        <input
          type="text"
          id="route-von"
          placeholder="z. B. Berlin, München, Köln..."
          autocomplete="off"
          required
        />
        <div id="dropdown-von" class="autocomplete-dropdown hidden"></div>
      </div>
    </div>

    <button type="button" id="btn-swap-routes" class="btn-swap" title="Start und Ziel tauschen" aria-label="Start und Ziel tauschen">
      ⇄
    </button>

    <div class="input-group">
      <label for="route-nach">Zielort (Nach)</label>
      <div class="autocomplete-wrapper">
        <input
          type="text"
          id="route-nach"
          placeholder="z. B. Hamburg, Nürnberg, Frankfurt..."
          autocomplete="off"
          required
        />
        <div id="dropdown-nach" class="autocomplete-dropdown hidden"></div>
      </div>
    </div>

    <div class="input-group input-group-btn">
      <label class="invisible-label">&nbsp;</label>
      <button type="submit" id="btn-search-route" class="btn btn-search">
        Verbindung anzeigen →
      </button>
    </div>
  </form>

  <div id="route-finder-error" class="route-finder-error hidden"></div>

  <div class="popular-routes">
    <span class="popular-label">Beliebte Verbindungen:</span>
    <div class="popular-chips">
      {popularRoutes.map(pr => (
        <a href={`/strecke/${pr.slug}`} class="popular-chip">
          <strong>{pr.from} → {pr.to}</strong>
          <span>{pr.time}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ routesData: routes, citiesData: cities }}>
  (function() {
    const vonInput = document.getElementById('route-von');
    const nachInput = document.getElementById('route-nach');
    const dropdownVon = document.getElementById('dropdown-von');
    const dropdownNach = document.getElementById('dropdown-nach');
    const swapBtn = document.getElementById('btn-swap-routes');
    const form = document.getElementById('route-finder-form');
    const errorEl = document.getElementById('route-finder-error');

    function normalizeText(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .replace(/ä/g, 'a')
        .replace(/ö/g, 'o')
        .replace(/ü/g, 'u')
        .replace(/ß/g, 'ss')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function slugifyCityPair(cityA, cityB) {
      const normA = normalizeText(cityA).replace(/\s+/g, '-');
      const normB = normalizeText(cityB).replace(/\s+/g, '-');
      return `${normA}-${normB}`;
    }

    function setupAutocomplete(input, dropdown) {
      input.addEventListener('input', function() {
        const val = this.value.trim();
        if (!val) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          return;
        }

        const queryNorm = normalizeText(val);
        const matches = citiesData.filter(c => normalizeText(c.city).includes(queryNorm));

        if (matches.length === 0) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          return;
        }

        dropdown.innerHTML = matches.map(c => `
          <div class="dropdown-item" data-city="${c.city}">
            <strong>${c.city}</strong>
            <span class="station-sub">${c.station}</span>
          </div>
        `).join('');

        dropdown.classList.remove('hidden');
      });

      dropdown.addEventListener('click', function(e) {
        const item = e.target.closest('.dropdown-item');
        if (item) {
          input.value = item.getAttribute('data-city');
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
        }
      });
    }

    setupAutocomplete(vonInput, dropdownVon);
    setupAutocomplete(nachInput, dropdownNach);

    document.addEventListener('click', function(e) {
      if (!vonInput.contains(e.target) && !dropdownVon.contains(e.target)) {
        dropdownVon.classList.add('hidden');
      }
      if (!nachInput.contains(e.target) && !dropdownNach.contains(e.target)) {
        dropdownNach.classList.add('hidden');
      }
    });

    swapBtn.addEventListener('click', function() {
      const temp = vonInput.value;
      vonInput.value = nachInput.value;
      nachInput.value = temp;
      errorEl.classList.add('hidden');
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      errorEl.classList.add('hidden');

      const vonVal = vonInput.value.trim();
      const nachVal = nachInput.value.trim();

      if (!vonVal || !nachVal) {
        errorEl.textContent = 'Bitte gib sowohl einen Start- als auch einen Zielort ein.';
        errorEl.classList.remove('hidden');
        return;
      }

      if (normalizeText(vonVal) === normalizeText(nachVal)) {
        errorEl.textContent = 'Start- und Zielort müssen unterschiedlich sein.';
        errorEl.classList.remove('hidden');
        return;
      }

      // Try matching slug directly or reverse slug
      const targetSlug = slugifyCityPair(vonVal, nachVal);
      const match = routesData.find(r => r.slug === targetSlug);

      if (match) {
        window.location.href = `/strecke/${match.slug}`;
        return;
      }

      const reverseSlug = slugifyCityPair(nachVal, vonVal);
      const reverseMatch = routesData.find(r => r.slug === reverseSlug);
      if (reverseMatch) {
        window.location.href = `/strecke/${reverseMatch.slug}`;
        return;
      }

      // If exact route not found in dataset, check if we have city matches
      const vonMatch = citiesData.find(c => normalizeText(c.city) === normalizeText(vonVal));
      const nachMatch = citiesData.find(c => normalizeText(c.city) === normalizeText(nachVal));

      if (!vonMatch || !nachMatch) {
        errorEl.textContent = `Für die Strecke ${vonVal} → ${nachVal} ist derzeit noch keine Detailseite vorhanden. Versuche z. B. Berlin, Hamburg, München oder Köln.`;
        errorEl.classList.remove('hidden');
        return;
      }

      errorEl.textContent = `Die Verbindung ${vonVal} → ${nachVal} wird in Kürze hinzugefügt!`;
      errorEl.classList.remove('hidden');
    });
  })();
</script>

<style>
  .route-finder {
    background: linear-gradient(135deg, #ffffff 0%, #f9f5ff 100%);
    border: 2px solid #5b21b6;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(91, 33, 182, 0.08);
    margin-bottom: 2rem;
  }

  .route-finder-header {
    margin-bottom: 1.2rem;
  }

  .route-finder-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5b21b6;
    background: #ede9fe;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.4rem;
  }

  .route-finder-header h2 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    color: #1f2937;
  }

  .route-finder-header p {
    margin: 0;
    color: #4b5563;
    font-size: 0.92rem;
  }

  .route-finder-form {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    gap: 0.8rem;
    align-items: end;
  }

  @media (max-width: 768px) {
    .route-finder-form {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .btn-swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  .input-group {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .invisible-label {
    user-select: none;
  }

  @media (max-width: 768px) {
    .invisible-label {
      display: none;
    }
  }

  .autocomplete-wrapper {
    position: relative;
  }

  .autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border: 1.5px solid #5b21b6;
    border-radius: 10px;
    margin-top: 4px;
    max-height: 220px;
    overflow-y: auto;
    z-index: 50;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .autocomplete-dropdown.hidden {
    display: none;
  }

  .dropdown-item {
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dropdown-item:last-child {
    border-bottom: none;
  }

  .dropdown-item:hover {
    background: #f5f3ff;
  }

  .dropdown-item strong {
    color: #1f2937;
    font-size: 0.92rem;
  }

  .station-sub {
    font-size: 0.78rem;
    color: #6b7280;
  }

  .btn-swap {
    background: #ede9fe;
    color: #5b21b6;
    border: 1.5px solid #c4b5fd;
    border-radius: 10px;
    width: 44px;
    height: 44px;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .btn-swap:hover {
    background: #5b21b6;
    color: white;
    border-color: #5b21b6;
  }

  .btn-search {
    background: #5b21b6;
    color: white;
    font-weight: 700;
    height: 44px;
    padding: 0 1.2rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .btn-search:hover {
    background: #4c1d95;
  }

  .route-finder-error {
    margin-top: 0.8rem;
    padding: 0.6rem 0.8rem;
    background: #fee2e2;
    border: 1px solid #fca5a5;
    color: #991b1b;
    border-radius: 8px;
    font-size: 0.88rem;
  }

  .route-finder-error.hidden {
    display: none;
  }

  .popular-routes {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e7eb;
  }

  .popular-label {
    display: block;
    font-size: 0.82rem;
    color: #6b7280;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .popular-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .popular-chip {
    background: white;
    border: 1px solid #ddd6fe;
    border-radius: 8px;
    padding: 0.4rem 0.7rem;
    text-decoration: none;
    color: #1f2937;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.2s;
  }

  .popular-chip:hover {
    border-color: #5b21b6;
    background: #f5f3ff;
    color: #5b21b6;
  }

  .popular-chip strong {
    font-weight: 600;
  }

  .popular-chip span {
    font-size: 0.75rem;
    color: #6b7280;
  }
</style>
