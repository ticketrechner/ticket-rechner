---
/**
 * RouteFinder.astro — Standalone route-finder component for the homepage.
 * Usage: import RouteFinder from '../components/RouteFinder.astro'; then <RouteFinder />
 */
import routes from '../data/routes.json';

// Build unique city list
const citySet = new Set<string>();
for (const r of routes) {
  citySet.add(r.from.city);
  citySet.add(r.to.city);
}
const cities = [...citySet].sort((a, b) => a.localeCompare(b, 'de'));

// Build lookup: "CityA|CityB" → slug
const pairMap: Record<string, string> = {};
for (const r of routes) {
  pairMap[`${r.from.city}|${r.to.city}`] = r.slug;
  const reverseKey = `${r.to.city}|${r.from.city}`;
  if (!pairMap[reverseKey]) {
    const rev = routes.find((x: any) => x.from.city === r.to.city && x.to.city === r.from.city);
    if (rev) pairMap[reverseKey] = rev.slug;
  }
}

// Top 6 popular routes
const popularSlugs = [
  'berlin-hamburg',
  'muenchen-nuernberg',
  'koeln-duesseldorf',
  'frankfurt-mainz',
  'hamburg-luebeck',
  'berlin-dresden',
];
const popularRoutes = popularSlugs
  .map((s) => routes.find((r: any) => r.slug === s))
  .filter(Boolean) as any[];
---

<section class="route-finder" id="streckensuche">
  <div class="rf-search-box">
    <h2 class="rf-title">🚆 Strecke finden</h2>
    <p class="rf-subtitle">Finde deine Verbindung mit dem Deutschlandticket — 100 Strecken, echte Daten.</p>

    <div class="rf-fields">
      <div class="rf-field">
        <label for="rf-von">Von</label>
        <div class="rf-input-wrap">
          <svg class="rf-icon" viewBox="0 0 20 20" fill="currentColor"><circle cx="10" cy="10" r="3"/></svg>
          <input
            type="text"
            id="rf-von"
            placeholder="z. B. Berlin, München …"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="rf-von-list"
            aria-autocomplete="list"
          />
          <ul id="rf-von-list" class="rf-dropdown" role="listbox"></ul>
        </div>
      </div>

      <button class="rf-swap" type="button" aria-label="Von und Nach tauschen" id="rf-swap-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>
      </button>

      <div class="rf-field">
        <label for="rf-nach">Nach</label>
        <div class="rf-input-wrap">
          <svg class="rf-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a6 6 0 00-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 00-6-6zm0 8.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
          <input
            type="text"
            id="rf-nach"
            placeholder="z. B. Hamburg, Köln …"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="rf-nach-list"
            aria-autocomplete="list"
          />
          <ul id="rf-nach-list" class="rf-dropdown" role="listbox"></ul>
        </div>
      </div>
    </div>

    <button class="rf-go" id="rf-go-btn" disabled>Verbindung anzeigen</button>
    <p class="rf-hint" id="rf-hint"></p>
  </div>

  <!-- Popular routes -->
  <div class="rf-popular">
    <h3 class="rf-pop-title">Beliebte Strecken</h3>
    <div class="rf-cards">
      {popularRoutes.map((r) => (
        <a href={`/strecke/${r.slug}`} class="rf-card">
          <span class="rf-card-cities">{r.from.city} → {r.to.city}</span>
          <span class="rf-card-meta">
            <span class="rf-card-train">{r.trains[0].replace(/\s*\(.*\)/, '')}</span>
            <span class="rf-card-dot">·</span>
            <span class="rf-card-time">{r.reisezeit.replace('ca. ', '').split(',')[0].split('(')[0].trim()}</span>
          </span>
          <span class="rf-card-badge">{r.umstiege === 0 ? 'Direkt' : `${r.umstiege} Umstieg`}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ cities, pairMap }}>
(function() {
  const vonInput = document.getElementById('rf-von');
  const nachInput = document.getElementById('rf-nach');
  const vonList = document.getElementById('rf-von-list');
  const nachList = document.getElementById('rf-nach-list');
  const goBtn = document.getElementById('rf-go-btn');
  const swapBtn = document.getElementById('rf-swap-btn');
  const hint = document.getElementById('rf-hint');

  let selectedVon = '';
  let selectedNach = '';

  function normalize(s) {
    return s.toLowerCase()
      .replace(/ä/g,'ae').replace(/ö/g,'oe').replace(/ü/g,'ue').replace(/ß/g,'ss')
      .replace(/[^a-z0-9]/g,'');
  }

  function filterCities(query, exclude) {
    if (!query || query.length < 1) return cities.filter(c => c !== exclude).slice(0, 8);
    const q = normalize(query);
    const startsWith = [];
    const contains = [];
    for (const c of cities) {
      if (c === exclude) continue;
      const n = normalize(c);
      if (n.startsWith(q)) startsWith.push(c);
      else if (n.includes(q)) contains.push(c);
    }
    return [...startsWith, ...contains].slice(0, 8);
  }

  function renderDropdown(list, items, input, onSelect) {
    list.innerHTML = '';
    if (!items.length) {
      list.style.display = 'none';
      input.setAttribute('aria-expanded', 'false');
      return;
    }
    items.forEach((city, i) => {
      const li = document.createElement('li');
      li.textContent = city;
      li.setAttribute('role', 'option');
      li.setAttribute('id', list.id + '-' + i);
      li.addEventListener('mousedown', (e) => { e.preventDefault(); onSelect(city); });
      list.appendChild(li);
    });
    list.style.display = 'block';
    input.setAttribute('aria-expanded', 'true');
  }

  function hideDropdown(list, input) {
    list.style.display = 'none';
    input.setAttribute('aria-expanded', 'false');
  }

  function checkRoute() {
    if (!selectedVon || !selectedNach) {
      goBtn.disabled = true;
      hint.textContent = '';
      hint.className = 'rf-hint';
      return;
    }
    if (selectedVon === selectedNach) {
      goBtn.disabled = true;
      hint.textContent = 'Bitte wähle zwei verschiedene Städte.';
      hint.className = 'rf-hint rf-hint-warn';
      return;
    }
    const slug = pairMap[selectedVon + '|' + selectedNach];
    if (slug) {
      goBtn.disabled = false;
      goBtn.dataset.slug = slug;
      hint.textContent = '\u2713 Strecke gefunden';
      hint.className = 'rf-hint rf-hint-ok';
    } else {
      goBtn.disabled = true;
      hint.textContent = 'Diese Strecke ist leider noch nicht verfügbar.';
      hint.className = 'rf-hint rf-hint-warn';
    }
  }

  function setupField(input, list, getExclude, setSelected) {
    const select = (city) => {
      input.value = city;
      setSelected(city);
      hideDropdown(list, input);
      checkRoute();
    };

    input.addEventListener('input', () => {
      const items = filterCities(input.value, getExclude());
      renderDropdown(list, items, input, select);
      const match = cities.find(c => c.toLowerCase() === input.value.trim().toLowerCase());
      setSelected(match || '');
      checkRoute();
    });

    input.addEventListener('focus', () => {
      const items = filterCities(input.value, getExclude());
      renderDropdown(list, items, input, select);
    });

    input.addEventListener('blur', () => {
      setTimeout(() => hideDropdown(list, input), 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = list.querySelectorAll('li');
      if (!items.length) return;
      const active = list.querySelector('.rf-active');
      let idx = active ? [...items].indexOf(active) : -1;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (active) active.classList.remove('rf-active');
        idx = (idx + 1) % items.length;
        items[idx].classList.add('rf-active');
        items[idx].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (active) active.classList.remove('rf-active');
        idx = idx <= 0 ? items.length - 1 : idx - 1;
        items[idx].classList.add('rf-active');
        items[idx].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (active) {
          select(active.textContent);
          if (input === vonInput && !selectedNach) nachInput.focus();
          else if (!goBtn.disabled) goBtn.click();
        }
      } else if (e.key === 'Escape') {
        hideDropdown(list, input);
      }
    });
  }

  setupField(vonInput, vonList, () => selectedNach, (c) => { selectedVon = c; });
  setupField(nachInput, nachList, () => selectedVon, (c) => { selectedNach = c; });

  swapBtn.addEventListener('click', () => {
    const tmpVal = vonInput.value;
    const tmpSel = selectedVon;
    vonInput.value = nachInput.value;
    selectedVon = selectedNach;
    nachInput.value = tmpVal;
    selectedNach = tmpSel;
    checkRoute();
    swapBtn.classList.add('rf-swap-spin');
    setTimeout(() => swapBtn.classList.remove('rf-swap-spin'), 300);
  });

  goBtn.addEventListener('click', () => {
    if (goBtn.dataset.slug) {
      window.location.href = '/strecke/' + goBtn.dataset.slug;
    }
  });
})();
</script>

<style>
  .route-finder {
    max-width: 680px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .rf-search-box {
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
    border: 2px solid #5b21b6;
    border-radius: 16px;
    padding: 1.5rem;
  }
  .rf-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 0.25rem;
  }
  .rf-subtitle {
    font-size: 0.85rem;
    color: #6b7280;
    margin: 0 0 1.25rem;
    line-height: 1.4;
  }

  .rf-fields {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .rf-field {
    flex: 1;
    min-width: 0;
  }
  .rf-field label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5b21b6;
    margin-bottom: 0.3rem;
  }
  .rf-input-wrap {
    position: relative;
  }
  .rf-icon {
    position: absolute;
    left: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #a78bfa;
    pointer-events: none;
    z-index: 1;
  }
  .rf-input-wrap input {
    width: 100%;
    padding: 0.6rem 0.75rem 0.6rem 2.1rem;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #1f2937;
    background: white;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .rf-input-wrap input:focus {
    border-color: #5b21b6;
    box-shadow: 0 0 0 3px rgba(91,33,182,0.12);
  }
  .rf-input-wrap input::placeholder { color: #9ca3af; }

  .rf-swap {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1.5px solid #d1d5db;
    border-radius: 50%;
    background: white;
    color: #5b21b6;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, transform 0.3s;
    margin-bottom: 1px;
  }
  .rf-swap svg { width: 18px; height: 18px; }
  .rf-swap:hover { background: #ede9fe; border-color: #5b21b6; }
  .rf-swap-spin { transform: rotate(180deg); }

  .rf-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: white;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    max-height: 220px;
    overflow-y: auto;
    z-index: 50;
  }
  .rf-dropdown li {
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    cursor: pointer;
    color: #1f2937;
    transition: background 0.1s;
  }
  .rf-dropdown li:hover,
  .rf-dropdown li.rf-active {
    background: #ede9fe;
    color: #5b21b6;
  }

  .rf-go {
    display: block;
    width: 100%;
    margin-top: 1rem;
    padding: 0.7rem;
    background: #5b21b6;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }
  .rf-go:hover:not(:disabled) { background: #4c1d95; }
  .rf-go:disabled { opacity: 0.45; cursor: not-allowed; }

  .rf-hint {
    font-size: 0.8rem;
    margin: 0.5rem 0 0;
    min-height: 1.2em;
    text-align: center;
  }
  .rf-hint-ok { color: #059669; font-weight: 600; }
  .rf-hint-warn { color: #b45309; }

  .rf-popular { margin-top: 1.75rem; }
  .rf-pop-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 0.75rem;
  }
  .rf-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .rf-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: white;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    padding: 0.75rem 0.85rem;
    text-decoration: none;
    color: #1f2937;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .rf-card:hover {
    border-color: #5b21b6;
    box-shadow: 0 3px 12px rgba(91,33,182,0.1);
  }
  .rf-card-cities {
    font-weight: 700;
    font-size: 0.9rem;
    color: #5b21b6;
    line-height: 1.2;
  }
  .rf-card-meta {
    font-size: 0.78rem;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .rf-card-dot { color: #d1d5db; }
  .rf-card-badge {
    display: inline-block;
    align-self: flex-start;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: #d1fae5;
    color: #065f46;
  }

  @media (max-width: 640px) {
    .rf-search-box { padding: 1.1rem; }
    .rf-fields { flex-direction: column; align-items: stretch; gap: 0.6rem; }
    .rf-swap {
      align-self: center;
      transform: rotate(0deg);
      margin: -0.25rem 0;
    }
    .rf-swap-spin { transform: rotate(180deg); }
    .rf-cards { grid-template-columns: repeat(2, 1fr); }
    .rf-title { font-size: 1.2rem; }
  }
</style>
