---
import routes from '../data/routes.json';

// Build list of unique cities with their station info
const cityMap = new Map<string, { city: string; station: string }>();
routes.forEach(r => {
  if (r.von?.city) cityMap.set(r.von.city, { city: r.von.city, station: r.von.station });
  if (r.nach?.city) cityMap.set(r.nach.city, { city: r.nach.city, station: r.nach.station });
});

const cities = Array.from(cityMap.values()).sort((a, b) => a.city.localeCompare(b.city, 'de'));

// Specified 6 popular routes
const popularRouteSlugs = [
  'berlin-hamburg',
  'muenchen-nuernberg',
  'koeln-duesseldorf',
  'frankfurt-mainz',
  'hamburg-luebeck',
  'berlin-potsdam'
];

const popularRoutes = popularRouteSlugs.map(slug => {
  const r = routes.find(item => item.slug === slug);
  if (r) {
    return {
      slug: r.slug,
      von: r.von.city,
      nach: r.nach.city,
      train: r.trains[0] || 'RE',
      time: r.reisezeit,
      badge: r.umstiege === 0 ? 'Direkt' : `${r.umstiege} Umstieg`
    };
  }
  // Fallback if slug slightly differs
  return null;
}).filter(Boolean);
---

<div id="streckensuche" class="route-finder card">
  <div class="route-finder-header">
    <span class="route-finder-badge">🚆 Strecke finden</span>
    <h2>Finde deine Verbindung mit dem Deutschlandticket — 100 Strecken, echte Daten.</h2>
    <p>Gib Start- und Zielort ein, um Fahrzeit, Direktverbindungen und Umstiege zu sehen.</p>
  </div>

  <form id="route-finder-form" class="route-finder-form" onsubmit="return false;">
    <div class="input-group">
      <label for="route-von">Abfahrtsort (Von)</label>
      <div class="autocomplete-wrapper">
        <input
          type="text"
          id="route-von"
          placeholder="z. B. Berlin, München, Köln..."
          autocomplete="off"
        />
        <div id="dropdown-von" class="autocomplete-dropdown hidden" role="listbox"></div>
      </div>
    </div>

    <button type="button" id="btn-swap-routes" class="btn-swap" title="Start und Ziel tauschen" aria-label="Start und Ziel tauschen">
      ⇄
    </button>

    <div class="input-group">
      <label for="route-nach">Zielort (Nach)</label>
      <div class="autocomplete-wrapper">
        <input
          type="text"
          id="route-nach"
          placeholder="z. B. Hamburg, Nürnberg, Frankfurt..."
          autocomplete="off"
        />
        <div id="dropdown-nach" class="autocomplete-dropdown hidden" role="listbox"></div>
      </div>
    </div>

    <div class="input-group input-group-btn">
      <label class="invisible-label">&nbsp;</label>
      <button type="submit" id="btn-search-route" class="btn btn-search" disabled>
        Verbindung anzeigen →
      </button>
    </div>
  </form>

  <div id="route-finder-hint" class="route-finder-hint hidden"></div>

  <div class="popular-routes-section">
    <h3>Beliebte Strecken</h3>
    <div class="popular-routes-grid">
      {popularRoutes.map(pr => (
        <a href={`/strecke/${pr.slug}`} class="popular-route-card">
          <div class="popular-card-top">
            <strong>{pr.von} → {pr.nach}</strong>
            <span class={`badge ${pr.badge === 'Direkt' ? 'badge-green' : 'badge-amber'}`}>{pr.badge}</span>
          </div>
          <div class="popular-card-meta">
            <span>{pr.train}</span> · <span>{pr.time}</span>
          </div>
        </a>
      ))}
    </div>
    <div class="all-routes-link">
      <a href="/ratgeber">Alle 100 Strecken anzeigen →</a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ routesData: routes, citiesData: cities }}>
  (function() {
    const vonInput = document.getElementById('route-von');
    const nachInput = document.getElementById('route-nach');
    const dropdownVon = document.getElementById('dropdown-von');
    const dropdownNach = document.getElementById('dropdown-nach');
    const swapBtn = document.getElementById('btn-swap-routes');
    const form = document.getElementById('route-finder-form');
    const searchBtn = document.getElementById('btn-search-route');
    const hintEl = document.getElementById('route-finder-hint');

    let activeRouteMatch = null;

    function normalizeText(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .replace(/ä/g, 'a')
        .replace(/ö/g, 'o')
        .replace(/ü/g, 'u')
        .replace(/ß/g, 'ss')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function findMatchingRoute(vonCity, nachCity) {
      if (!vonCity || !nachCity) return null;
      const vNorm = normalizeText(vonCity);
      const nNorm = normalizeText(nachCity);

      // Check direct
      let match = routesData.find(r => normalizeText(r.von.city) === vNorm && normalizeText(r.nach.city) === nNorm);
      if (match) return { route: match, isReverse: false };

      // Check reverse
      let reverseMatch = routesData.find(r => normalizeText(r.von.city) === nNorm && normalizeText(r.nach.city) === vNorm);
      if (reverseMatch) return { route: reverseMatch, isReverse: true };

      return null;
    }

    function updateState() {
      const vVal = vonInput.value.trim();
      const nVal = nachInput.value.trim();

      if (!vVal || !nVal) {
        searchBtn.disabled = true;
        hintEl.className = 'route-finder-hint hidden';
        activeRouteMatch = null;
        return;
      }

      if (normalizeText(vVal) === normalizeText(nVal)) {
        searchBtn.disabled = true;
        hintEl.className = 'route-finder-hint hint-warning';
        hintEl.innerHTML = '⚠️ Start- und Zielort müssen unterschiedlich sein.';
        activeRouteMatch = null;
        return;
      }

      const found = findMatchingRoute(vVal, nVal);
      if (found) {
        activeRouteMatch = found.route;
        searchBtn.disabled = false;
        hintEl.className = 'route-finder-hint hint-success';
        const trainInfo = found.route.trains ? found.route.trains[0] : 'RE';
        const umst = found.route.umstiege === 0 ? 'ohne Umstieg' : `${found.route.umstiege}x Umstieg`;
        hintEl.innerHTML = `✓ Strecke gefunden: <strong>${vVal} → ${nVal}</strong> (${trainInfo} · ${found.route.reisezeit} · ${umst})`;
      } else {
        activeRouteMatch = null;
        searchBtn.disabled = true;
        hintEl.className = 'route-finder-hint hint-warning';
        hintEl.innerHTML = `⚠️ Für <strong>${vVal} → ${nVal}</strong> ist noch keine direkte Detailseite vorhanden.`;
      }
    }

    function setupAutocomplete(input, dropdown, otherInput) {
      let selectedIndex = -1;

      function renderMatches() {
        const val = input.value.trim();
        const otherVal = normalizeText(otherInput.value.trim());

        if (!val) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          selectedIndex = -1;
          return;
        }

        const queryNorm = normalizeText(val);

        // Filter cities, max 8 results, exclude currently selected city in other field
        const matches = citiesData
          .filter(c => {
            const cNorm = normalizeText(c.city);
            return cNorm.includes(queryNorm) && cNorm !== otherVal;
          })
          .slice(0, 8);

        if (matches.length === 0) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          selectedIndex = -1;
          return;
        }

        dropdown.innerHTML = matches.map((c, i) => `
          <div class="dropdown-item ${i === selectedIndex ? 'active' : ''}" data-city="${c.city}" role="option">
            <strong>${c.city}</strong>
            <span class="station-sub">${c.station}</span>
          </div>
        `).join('');

        dropdown.classList.remove('hidden');
      }

      input.addEventListener('input', function() {
        selectedIndex = -1;
        renderMatches();
        updateState();
      });

      input.addEventListener('keydown', function(e) {
        const items = dropdown.querySelectorAll('.dropdown-item');
        if (dropdown.classList.contains('hidden') || items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = (selectedIndex + 1) % items.length;
          highlightItem(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = (selectedIndex - 1 + items.length) % items.length;
          highlightItem(items);
        } else if (e.key === 'Enter') {
          if (selectedIndex >= 0 && items[selectedIndex]) {
            e.preventDefault();
            selectCity(items[selectedIndex].getAttribute('data-city'));
          }
        } else if (e.key === 'Escape') {
          dropdown.classList.add('hidden');
          selectedIndex = -1;
        }
      });

      function highlightItem(items) {
        items.forEach((item, idx) => {
          if (idx === selectedIndex) {
            item.classList.add('active');
            item.scrollIntoView({ block: 'nearest' });
          } else {
            item.classList.remove('active');
          }
        });
      }

      function selectCity(city) {
        input.value = city;
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        selectedIndex = -1;
        updateState();
      }

      dropdown.addEventListener('click', function(e) {
        const item = e.target.closest('.dropdown-item');
        if (item) {
          selectCity(item.getAttribute('data-city'));
        }
      });
    }

    setupAutocomplete(vonInput, dropdownVon, nachInput);
    setupAutocomplete(nachInput, dropdownNach, vonInput);

    document.addEventListener('click', function(e) {
      if (!vonInput.contains(e.target) && !dropdownVon.contains(e.target)) {
        dropdownVon.classList.add('hidden');
      }
      if (!nachInput.contains(e.target) && !dropdownNach.contains(e.target)) {
        dropdownNach.classList.add('hidden');
      }
    });

    swapBtn.addEventListener('click', function() {
      const temp = vonInput.value;
      vonInput.value = nachInput.value;
      nachInput.value = temp;
      updateState();
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if (activeRouteMatch) {
        window.location.href = `/strecke/${activeRouteMatch.slug}`;
      }
    });
  })();
</script>

<style>
  .route-finder {
    background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%);
    border: 2px solid #5b21b6;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(91, 33, 182, 0.08);
    margin-bottom: 2.5rem;
    scroll-margin-top: 80px;
  }

  .route-finder-header {
    margin-bottom: 1.2rem;
  }

  .route-finder-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5b21b6;
    background: #ede9fe;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    margin-bottom: 0.4rem;
  }

  .route-finder-header h2 {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    color: #1f2937;
  }

  .route-finder-header p {
    margin: 0;
    color: #4b5563;
    font-size: 0.93rem;
  }

  .route-finder-form {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    gap: 0.8rem;
    align-items: end;
  }

  @media (max-width: 768px) {
    .route-finder-form {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .btn-swap {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  .input-group {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .invisible-label {
    user-select: none;
  }

  @media (max-width: 768px) {
    .invisible-label {
      display: none;
    }
  }

  .autocomplete-wrapper {
    position: relative;
  }

  .autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: white;
    border: 1.5px solid #5b21b6;
    border-radius: 10px;
    margin-top: 4px;
    max-height: 240px;
    overflow-y: auto;
    z-index: 50;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  .autocomplete-dropdown.hidden {
    display: none;
  }

  .dropdown-item {
    padding: 0.65rem 0.85rem;
    cursor: pointer;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dropdown-item:last-child {
    border-bottom: none;
  }

  .dropdown-item:hover,
  .dropdown-item.active {
    background: #ede9fe;
  }

  .dropdown-item strong {
    color: #1f2937;
    font-size: 0.92rem;
  }

  .station-sub {
    font-size: 0.78rem;
    color: #6b7280;
  }

  .btn-swap {
    background: #ede9fe;
    color: #5b21b6;
    border: 1.5px solid #c4b5fd;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.3rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .btn-swap:hover {
    background: #5b21b6;
    color: white;
    border-color: #5b21b6;
  }

  .btn-search {
    background: #5b21b6;
    color: white;
    font-weight: 700;
    height: 44px;
    padding: 0 1.3rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, opacity 0.2s;
  }

  .btn-search:hover:not(:disabled) {
    background: #4c1d95;
  }

  .btn-search:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .route-finder-hint {
    margin-top: 0.9rem;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .route-finder-hint.hidden {
    display: none;
  }

  .hint-success {
    background: #d1fae5;
    border: 1px solid #6ee7b7;
    color: #065f46;
  }

  .hint-warning {
    background: #fef3c7;
    border: 1px solid #fcd34d;
    color: #92400e;
  }

  /* Popular Routes Section */
  .popular-routes-section {
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    border-top: 1px solid #e5e7eb;
  }

  .popular-routes-section h3 {
    margin: 0 0 0.8rem;
    font-size: 1.1rem;
    color: #1f2937;
  }

  .popular-routes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }

  @media (max-width: 768px) {
    .popular-routes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .popular-routes-grid {
      grid-template-columns: 1fr;
    }
  }

  .popular-route-card {
    background: white;
    border: 1.5px solid #e5e7eb;
    border-radius: 12px;
    padding: 0.8rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .popular-route-card:hover {
    border-color: #5b21b6;
    box-shadow: 0 3px 12px rgba(91, 33, 182, 0.1);
  }

  .popular-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .popular-card-top strong {
    font-size: 0.92rem;
    color: #1f2937;
  }

  .popular-card-meta {
    font-size: 0.82rem;
    color: #6b7280;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .badge-green {
    background: #d1fae5;
    color: #065f46;
  }

  .badge-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .all-routes-link {
    margin-top: 1rem;
    text-align: right;
  }

  .all-routes-link a {
    color: #5b21b6;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .all-routes-link a:hover {
    text-decoration: underline;
  }
</style>
